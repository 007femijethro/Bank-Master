DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-a-separate-32-byte-random-secret
COOKIE_SECURE=true
PORT=5000
PUBLIC_URL=https://redbirdfcu.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
